{
  "name": "remarkable-templates",
  "description": "Browser-based SVG viewer and editor for reMarkable tablet template files",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuttlefisch/RemarkableCustomTemplates"
  },
  "author": "cuttlefisch",
  "homepage": "https://github.com/cuttlefisch/RemarkableCustomTemplates#readme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm server:dev\" \"vite\"",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-sample-icons": "tsx scripts/generate-sample-icons.ts",
    "electron:dev": "node scripts/build-electron.mjs && electron .",
    "electron:build": "pnpm build && node scripts/build-electron.mjs && electron-builder",
    "electron:build:mac": "pnpm build && node scripts/build-electron.mjs && electron-builder --mac",
    "electron:build:win": "pnpm build && node scripts/build-electron.mjs && electron-builder --win",
    "electron:build:linux": "pnpm build && node scripts/build-electron.mjs && electron-builder --linux",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "validate-xovi": "tsx scripts/validate-xovi-checksums.ts",
    "generate-xovi-manifest": "tsx scripts/generate-xovi-manifest.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@monaco-editor/react": "^4.7.0",
    "fastify": "^5.8.2",
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "electron",
      "esbuild",
      "ssh2"
    ]
  }
}
